# Copy this file to .env and fill in local credentials.
# Do not commit .env.
# Database URL examples (psycopg2-binary is installed by requirements.txt):
# Local: postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/Inventory_Management
# Or:    postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/Inventory_Management
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/Inventory_Management

# Generate a unique key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY

# development | production
ENVIRONMENT=development

# Comma-separated allowed origins for production
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
