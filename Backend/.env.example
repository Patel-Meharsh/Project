# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:    postgresql://postgres:password@localhost:5432/gateway_inventory
# Docker:   postgresql://postgres:password@db:5432/gateway_inventory
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:Layla@localhost:5432/gateway_inventory

# ── Security ─────────────────────────────────────────────────────────────────
